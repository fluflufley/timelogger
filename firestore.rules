rules_version = '2';

// Each signed-in user can only read and write their own entries:
//   users/{uid}/entries/{entryId}
//   users/{uid}/settings/{docId}
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/entries/{entryId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validEntry(request.resource.data);
    }

    // per-user preferences (activity colors)
    match /users/{uid}/settings/{docId} {
      allow read, write: if isOwner(uid);
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
      // Optional: lock the whole app to just your Google account by using this instead:
      // return request.auth != null && request.auth.uid == uid
      //        && request.auth.token.email == "you@gmail.com";
    }

    function validEntry(d) {
      return d.start is number
        && (d.activity == null || (d.activity is string && d.activity.size() <= 500))
        && d.note is string && d.note.size() <= 5000;
    }
  }
}
